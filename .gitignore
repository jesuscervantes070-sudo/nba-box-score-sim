# Fetched/generated data -- not source code, and can always be rebuilt by
# re-running the data-fetch script. No reason to track it in git.
cache/

# Python's compiled-bytecode cache folders -- auto-generated, machine-specific.
__pycache__/
*.pyc

# macOS Finder metadata file that can end up in random folders.
.DS_Store

# Outreach copy for the user (Reddit/HN post drafts, comment-reply
# drafts) -- not project documentation, deliberately kept out of the
# shipped codebase. A pattern, not a growing list of exact filenames,
# since there'll be more of these.
docs/post_draft*.md
docs/reply_to_*.md
